{
  "permissions": {
    "defaultMode": "plan"
  },
  "model": "opusplan",
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); echo \"$(echo \"$input\" | jq -r '.model.display_name')\""
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "tui": "default",
  "disableAutoMode": "disable",
  "agentPushNotifEnabled": true,
  "enabledPlugins": {
    "slack@claude-plugins-official": true
  }
}
